{
  "name": "hub",
  "version": "0.0.0",
  "private": true,
  "description": "Renaissance Hub: the one server-side piece. Intent engine, catalogue, fetch pipeline, enrichment. Holds every key.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
