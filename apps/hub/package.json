{
  "name": "hub",
  "version": "0.0.0",
  "private": true,
  "description": "Renaissance Hub: the one server-side piece. Intent engine, catalogue, fetch pipeline, enrichment. Holds every key.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "@renaissance/core": "workspace:*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
