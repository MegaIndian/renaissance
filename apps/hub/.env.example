# Copy to apps/hub/.env for local runs (never committed). The dev and start scripts load it with
# `node --env-file-if-exists=.env`; in production these are the container's environment.
NODE_ENV=development
RENAISSANCE_HUB_HOST=0.0.0.0
RENAISSANCE_HUB_PORT=8787
# Origins allowed to call the hub from a browser, comma separated. Empty outside production means
# http://localhost:5173 (the web dev server); empty in production means same origin only.
RENAISSANCE_HUB_CORS_ORIGINS=http://localhost:5173
# Jellyfin the hub scans and reads from.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
# Optional in phase 0; required from phase 2 for the intent engine and enrichment.
ANTHROPIC_API_KEY=
ANTHROPIC_INTENT_MODEL=claude-opus-5-5
ANTHROPIC_ENRICHMENT_MODEL=claude-haiku-5-5
# Optional request pipeline (phase 2).
LIDARR_URL=
LIDARR_API_KEY=
SLSKD_URL=
SLSKD_API_KEY=
