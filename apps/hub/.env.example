# Copy to apps/hub/.env for local runs (never committed). The dev and start scripts load it with
# `node --env-file-if-exists=.env`, and `pnpm dev` at the root reads it too (for the port it polls);
# in production these are the container's environment (docker/hub/compose.yml). docs/hub-api.md
# explains each variable.
NODE_ENV=development
RENAISSANCE_HUB_HOST=0.0.0.0
RENAISSANCE_HUB_PORT=8787
# Origins allowed to call the hub from a browser, comma separated. Empty outside production means
# http://localhost:5173 (the web dev server); empty in production means same origin only.
RENAISSANCE_HUB_CORS_ORIGINS=http://localhost:5173
# Trust x-forwarded-for from a reverse proxy so the rate limit sees the client address.
RENAISSANCE_HUB_TRUST_PROXY=false
# Requests per minute one client address may make on every route but /health (0 turns the limit off).
RENAISSANCE_HUB_RATE_LIMIT=120

# The household database (profiles, requests, cache). `:memory:` keeps nothing.
RENAISSANCE_HUB_DB=./data/hub.sqlite
# Log every slskd and Lidarr write instead of sending it; searches still run.
RENAISSANCE_HUB_DRY_RUN=false

# Jellyfin: the hub validates app tokens against it (GET /Users/Me) and looks the library up with
# the API key for the "already on the server" check and the library refresh after an import.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# Optional. The fetch step's tie-break: when two Soulseek files score within a few points, the
# model picks one of them. Off unless RENAISSANCE_FETCH_MODEL_PICK is on AND a key is set; without
# either the deterministic ranking decides alone.
RENAISSANCE_FETCH_MODEL_PICK=false
ANTHROPIC_API_KEY=
ANTHROPIC_INTENT_MODEL=claude-opus-5-5
ANTHROPIC_ENRICHMENT_MODEL=claude-haiku-5-5

# The fetch pipeline. Singles: slskd search and download, then Lidarr ManualImport. Albums: Lidarr.
LIDARR_URL=
LIDARR_API_KEY=
# Root folder for new artists; empty takes Lidarr's first root folder.
LIDARR_ROOT_FOLDER=
# The slskd completed-downloads folder as Lidarr's container sees it.
RENAISSANCE_LIDARR_DOWNLOADS_DIR=/downloads/complete
# Where soularr parks files Lidarr refused, as Lidarr sees it, when it is not under the folder above.
# RENAISSANCE_LIDARR_FAILED_IMPORTS_DIR=/downloads/failed_imports
SLSKD_URL=
SLSKD_API_KEY=

# Optional: Navidrome gets a startScan after each import.
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Sent to MusicBrainz in the User-Agent (an email or project URL), as its etiquette asks.
RENAISSANCE_CONTACT=
