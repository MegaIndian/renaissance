# Normalise text to LF in the repo and in every checkout, so Prettier (endOfLine: lf) passes on Windows.
* text=auto eol=lf

# Binary: never normalised or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp3 binary
*.flac binary
*.ogg binary
*.opus binary
*.m4a binary
*.wav binary
*.mp4 binary
*.webm binary
*.pdf binary
*.zip binary
*.gz binary
*.jar binary
